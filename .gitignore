# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
devlog.txt

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Raw community feedback: verbatim quotes + handles from private Discord channels.
# Kept locally, never published. The specs written FROM that feedback quote it,
# so they stay local too — a commit cannot be taken back out of the history.
/docs/feedback-*.md
/docs/spec-*.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
