# Copy to .env.local (git-ignored) and fill in. Never commit the filled-in file.

# ---- MongoDB ----
# Atlas connection string, or a local mongod for development.
MONGODB_URI="mongodb://127.0.0.1:27017/aoe4banpick"
MONGODB_DB="aoe4banpick"

# ---- Auth.js (NextAuth v5) ----
# Also signs the Socket.IO join tickets, so the server refuses to start without it.
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
# Public base URL of the app (used by Auth.js). Set to the Railway URL in production.
AUTH_URL="http://localhost:3000"

# ---- Super-admin (seeded on startup) ----
# The seed FORCE-RESETS this account's password to ADMIN_PASSWORD on every boot.
# There is no default password: leave ADMIN_PASSWORD blank and admin seeding is
# skipped entirely, rather than shipping a known super-admin login.
ADMIN_USERNAME="Max"
ADMIN_PASSWORD=""

# ---- Server ----
PORT=3000
# Public URL the browser connects to for Socket.IO (blank = same origin).
NEXT_PUBLIC_SOCKET_URL=""
